{
  "name": "magpie-plugin-modelscope",
  "version": "0.3.2",
  "description": "ModelScope for magpie: China and international providers with chat, images, daily check-in and magicube usage",
  "author": "MisonL; Woni111 fork",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Woni111/magpie-plugin-msmoli.git"
  },
  "homepage": "https://github.com/Woni111/magpie-plugin-msmoli",
  "bugs": {
    "url": "https://github.com/Woni111/magpie-plugin-msmoli/issues"
  },
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "bin": {
    "magpie-plugin-modelscope": "./bin/sync.mjs"
  },
  "files": [
    "index.mjs",
    "provider.mjs",
    "bin/sync.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode-plugin",
    "modelscope",
    "modelscope-intl",
    "api-inference",
    "magicube",
